st.set_page_config(page_title="MySQL MCQ Quiz", page_icon="📝")

# Session State Initialization
if "test_started" not in st.session_state:
    st.session_state.test_started = False
if "test_submitted" not in st.session_state:
    st.session_state.test_submitted = False

st.title("📝 MySQL Online Assessment Test")

# Screen 1: Login & Rules
if not st.session_state.test_started:
    st.subheader("Student Details & Test Instructions")
    student_name = st.text_input("Enter Your Full Name:")
    student_id = st.text_input("Enter Student Roll / ID Number:")

    st.markdown("""
    ---
    ### Rules:
    - **Total Questions:** 20 (Randomly selected from 50)
    - **Time Limit:** 20 Minutes (Countdown timer will begin as soon as you start)
    - Each question carries **1 mark**.
    ---
    """)

    if st.button("Start Test"):
        if student_name and student_id:
            st.session_state.student_name = student_name
            st.session_state.student_id = student_id
            st.session_state.test_started = True
            st.session_state.start_time = time.time()
            st.session_state.selected_questions = random.sample(ALL_QUESTIONS, 20)
            st.rerun()
        else:
            st.warning("Please enter your name and student ID before starting.")

# Screen 2: Test Dashboard
elif st.session_state.test_started and not st.session_state.test_submitted:
    time_limit = 20 * 60  # 20 minutes in seconds
    elapsed_time = time.time() - st.session_state.start_time
    remaining_time = time_limit - elapsed_time

    if remaining_time <= 0:
        st.session_state.test_submitted = True
        st.warning("⏱️ Time limit reached! Your test has been automatically submitted.")
        st.rerun()

    mins, secs = divmod(int(remaining_time), 60)
    st.sidebar.markdown(f"## ⏱️ Time Remaining: **{mins:02d}:{secs:02d}**")
    st.sidebar.markdown(f"**Student:** {st.session_state.student_name}")
    st.sidebar.markdown(f"**ID:** {st.session_state.student_id}")

    st.write("---")
    user_answers = {}

    with st.form("quiz_form"):
        for idx, q_data in enumerate(st.session_state.selected_questions, 1):
            st.markdown(f"**Q{idx}. {q_data['q']}**")
            user_answers[idx] = st.radio(
                label=f"Select answer for Q{idx}:",
                options=q_data["options"],
                index=None,
                key=f"q_{idx}"
            )
            st.write("")

        submitted = st.form_submit_button("Submit Test")
        if submitted:
            st.session_state.user_answers = user_answers
            st.session_state.test_submitted = True
            st.rerun()

# Screen 3: Results & Feedback
else:
    st.subheader(f"Results for {st.session_state.student_name} (ID: {st.session_state.student_id})")
    score = 0
    total = len(st.session_state.selected_questions)

    for idx, q_data in enumerate(st.session_state.selected_questions, 1):
        user_ans = st.session_state.get("user_answers", {}).get(idx)
        if user_ans == q_data["ans"]:
            score += 1

    st.success(f"### Score: {score} / {total}")
    st.markdown("---")
    st.subheader("Question Breakdown & Solutions")

    for idx, q_data in enumerate(st.session_state.selected_questions, 1):
        user_ans = st.session_state.get("user_answers", {}).get(idx)
        is_correct = (user_ans == q_data["ans"])

        if is_correct:
            st.markdown(f"**Q{idx}. {q_data['q']}** ✅")
        else:
            st.markdown(f"**Q{idx}. {q_data['q']}** ❌")

        st.write(f"- **Your Answer:** {user_ans if user_ans else 'Not Answered'}")
        st.write(f"- **Correct Answer:** {q_data['ans']}")
        st.caption(f"💡 *Solution:* {q_data['sol']}")
        st.write("---")
